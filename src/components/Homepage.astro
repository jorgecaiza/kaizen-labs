---
import { content, type Language } from "../i18n/content";
import { projects } from "../data/projects";

const language: Language = Astro.props.language as Language;
const copy = content[language];
const linkedin = "https://www.linkedin.com/in/jorge-caiza-balseca-26aa6227a/";
const configuredBase = import.meta.env.BASE_URL;
const basePath = configuredBase.endsWith("/") ? configuredBase : `${configuredBase}/`;
const imageRoot = `${basePath}images`;
const siteUrl = Astro.site;
const spanishUrl = new URL(basePath, siteUrl).href;
const englishUrl = new URL(`${basePath}en/`, siteUrl).href;
const canonicalUrl = language === "en" ? englishUrl : spanishUrl;
const socialImageUrl = new URL(`${imageRoot.slice(1)}/logo.png`, siteUrl).href;
const hrefFor = (key: string) => `#${key}`;
---

<!doctype html>
<html lang={language}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={copy.meta.description} data-i18n="meta.description" />
		<meta name="theme-color" content="#0b0d10" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Kaizen Labs" />
		<meta property="og:title" content={copy.meta.ogTitle} data-i18n="meta.ogTitle" />
		<meta property="og:description" content={copy.meta.ogDescription} data-i18n="meta.ogDescription" />
		<meta property="og:image" content={socialImageUrl} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={copy.meta.ogTitle} data-i18n="meta.ogTitle" />
		<meta name="twitter:description" content={copy.meta.ogDescription} data-i18n="meta.ogDescription" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/png" href={`${imageRoot}/logo.png`} />
		<link rel="alternate" hreflang="es" href={spanishUrl} />
		<link rel="alternate" hreflang="en" href={englishUrl} />
		<link rel="alternate" hreflang="x-default" href={spanishUrl} />
		<title data-i18n="meta.title">{copy.meta.title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main" data-i18n="accessibility.skip">{copy.accessibility.skip}</a>
		<header class="site-header">
			<div class="header-inner wrap">
				<a class="brand" href="#inicio" aria-label="Kaizen Labs — inicio">
					<img src={`${imageRoot}/logo.png`} alt="" width="181" height="95" />
					<span class="brand-name">Kaizen<span>Labs</span></span>
				</a>
				<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label={copy.nav.menu} data-i18n-aria="nav.menu"><span></span><span></span></button>
				<nav class="primary-nav" id="primary-nav" aria-label={copy.nav.navigationName} data-i18n-aria="nav.navigationName">
					<a href={hrefFor("inicio")} data-i18n="nav.home">{copy.nav.home}</a>
					<a href={hrefFor("capacidades")} data-i18n="nav.work">{copy.nav.work}</a>
					<a href={hrefFor("proyectos")} data-i18n="nav.projects">{copy.nav.projects}</a>
					<a href={hrefFor("trayectoria")} data-i18n="nav.journey">{copy.nav.journey}</a>
					<a href={hrefFor("fundador")} data-i18n="nav.founder">{copy.nav.founder}</a>
					<a class="nav-cta" href={hrefFor("contacto")} data-i18n="nav.contact">{copy.nav.contact}</a>
					<button class="language-toggle" type="button" aria-label={copy.nav.language} data-i18n-aria="nav.language"><span class="language-current">{language.toUpperCase()}</span><span class="language-separator">/</span> {language === "es" ? "EN" : "ES"}</button>
				</nav>
			</div>
		</header>

		<main id="main">
			<section class="hero section-wrap" id="inicio" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span class="status-dot"></span><span data-i18n="hero.eyebrow">{copy.hero.eyebrow}</span></p>
					<h1 id="hero-title" data-i18n="hero.title">{copy.hero.title}</h1>
					<p class="hero-body" data-i18n="hero.body">{copy.hero.body}</p>
					<div class="hero-actions">
						<a class="button button-primary" href={hrefFor("contacto")}><span data-i18n="hero.primary">{copy.hero.primary}</span><span class="arrow-up-right" aria-hidden="true"></span></a>
						<a class="text-link" href={hrefFor("capacidades")}><span data-i18n="hero.secondary">{copy.hero.secondary}</span><span aria-hidden="true">↓</span></a>
					</div>
					<p class="hero-note"><span class="note-line"></span><span data-i18n="hero.note">{copy.hero.note}</span></p>
				</div>
				<div class="hero-visual">
					<div class="hero-grid" aria-hidden="true"></div>
					<div class="hero-index" aria-hidden="true"><span>KL—01</span><span>BUILD / ITERATE</span></div>
					<img src={`${imageRoot}/skolldev.webp`} alt={copy.hero.imageAlt} data-i18n-alt="hero.imageAlt" width="960" height="1280" fetchpriority="high" />
					<div class="visual-caption"><span class="caption-mark"><span class="arrow-up-right" aria-hidden="true"></span></span><span>KAIZEN LABS</span><span class="caption-rule"></span><span>ECUADOR</span></div>
				</div>
				<div class="hero-bottom" aria-hidden="true"><span>01 / 04</span><span class="progress-track"><i></i></span><span>BUILD. IMPROVE. EVOLVE.</span></div>
			</section>

			<section class="intro section-wrap" id="que-hacemos">
				<div class="section-label"><span class="section-index">01</span><span data-i18n="intro.label">{copy.intro.label}</span></div>
				<div class="intro-content"><h2 data-i18n="intro.title">{copy.intro.title}</h2><p data-i18n="intro.body">{copy.intro.body}</p></div>
				<div class="intro-mark" aria-hidden="true">改善<span>KAIZEN / CONTINUOUS IMPROVEMENT</span></div>
			</section>

			<section class="capabilities section-wrap" id="capacidades">
				<div class="section-heading"><div class="section-label"><span class="section-index">02</span><span data-i18n="capabilities.label">{copy.capabilities.label}</span></div><h2 data-i18n="capabilities.title">{copy.capabilities.title}</h2></div>
				<div class="capability-list">
					{copy.capabilities.items.map((item, index) => <article class="capability-row" data-reveal>
						<span class="row-number" data-i18n={`capabilities.items.${index}.number`}>{item.number}</span>
						<h3 data-i18n={`capabilities.items.${index}.title`}>{item.title}</h3>
						<p data-i18n={`capabilities.items.${index}.body`}>{item.body}</p>
						<span class="row-arrow" aria-hidden="true"></span>
					</article>)}
				</div>
			</section>

			<section class="projects section-wrap" id="proyectos">
				<div class="project-heading"><div><div class="section-label"><span class="section-index">03</span><span data-i18n="projects.label">{copy.projects.label}</span></div><h2 data-i18n="projects.title">{copy.projects.title}</h2></div><p data-i18n="projects.body">{copy.projects.body}</p></div>
				{projects.length ? <div class="project-grid">{projects.map((project) => <article class="project-item"><p class="eyebrow">{project.category[language]}</p><h3>{project.name[language]}</h3><p>{project.description[language]}</p><ul>{project.technologies.map((technology) => <li>{technology}</li>)}</ul>{project.url && <a href={project.url}>{copy.projects.view} <span class="arrow-up-right" aria-hidden="true"></span></a>}{project.repository && <a href={project.repository}>{copy.projects.repository} <span class="arrow-up-right" aria-hidden="true"></span></a>}</article>)}</div> : <div class="projects-empty"><span class="empty-symbol" aria-hidden="true">[ + ]</span><div><span class="empty-status" data-i18n="projects.status">{copy.projects.status}</span><p data-i18n="projects.empty">{copy.projects.empty}</p></div><span class="empty-index" aria-hidden="true">KL / WORK</span></div>}
			</section>

			<section class="stack section-wrap" id="tecnologia">
				<div class="stack-intro"><div class="section-label"><span class="section-index">04</span><span data-i18n="stack.label">{copy.stack.label}</span></div><h2 data-i18n="stack.title">{copy.stack.title}</h2><p data-i18n="stack.body">{copy.stack.body}</p></div>
				<div class="stack-groups">{copy.stack.groups.map((group, index) => <div class="stack-group"><h3><span>0{index + 1}</span><span data-i18n={`stack.groups.${index}`}>{group}</span></h3><div>{copy.stack.items[index].map((item, itemIndex) => <span class="tool-name" data-i18n={`stack.items.${index}.${itemIndex}`}>{item}</span>)}</div></div>)}</div>
			</section>

			<section class="experience section-wrap" id="trayectoria">
				<div class="experience-intro"><div class="section-label"><span class="section-index">05</span><span data-i18n="experience.label">{copy.experience.label}</span></div><h2 data-i18n="experience.title">{copy.experience.title}</h2><p data-i18n="experience.body">{copy.experience.body}</p><div class="timeline-decoration" aria-hidden="true">2015 <span>→</span> 2025 <span>→</span> KL</div></div>
				<div class="timeline">{copy.experience.items.map((item, index) => <article class="timeline-item" data-reveal><div class="timeline-point" aria-hidden="true"><span>{String(index + 1).padStart(2, "0")}</span></div><div class="timeline-copy"><span class="timeline-period" data-i18n={`experience.items.${index}.period`}>{item.period}</span><h3 data-i18n={`experience.items.${index}.role`}>{item.role}</h3><p class="timeline-place" data-i18n={`experience.items.${index}.place`}>{item.place}</p><p class="timeline-detail" data-i18n={`experience.items.${index}.detail`}>{item.detail}</p></div></article>)}</div>
			</section>

			<section class="founder section-wrap" id="fundador">
				<div class="founder-image"><img src={`${imageRoot}/retrato.webp`} alt={copy.founder.portraitAlt} data-i18n-alt="founder.portraitAlt" width="944" height="1180" loading="lazy" /><span class="image-coordinate" data-i18n="founder.imageCaption">{copy.founder.imageCaption}</span><span class="image-frame" aria-hidden="true"></span></div>
				<div class="founder-copy"><div class="section-label"><span class="section-index">06</span><span data-i18n="founder.label">{copy.founder.label}</span></div><p class="founder-role" data-i18n="founder.role">{copy.founder.role}</p><h2 data-i18n="founder.title">{copy.founder.title}</h2><p class="founder-body" data-i18n="founder.body">{copy.founder.body}</p><a class="text-link linkedin-link" href={linkedin} target="_blank" rel="noreferrer"><span data-i18n="founder.linkedin">{copy.founder.linkedin}</span><span class="arrow-up-right" aria-hidden="true"></span></a><p class="founder-location"><span class="status-dot"></span><span data-i18n="founder.location">{copy.founder.location}</span></p></div>
			</section>

			<section class="process section-wrap" id="proceso">
				<div class="section-heading"><div class="section-label"><span class="section-index">07</span><span data-i18n="process.label">{copy.process.label}</span></div><h2 data-i18n="process.title">{copy.process.title}</h2></div>
				<div class="process-steps">{copy.process.steps.map((step, index) => <article class="process-step"><span class="process-number">0{index + 1}</span><h3 data-i18n={`process.steps.${index}.title`}>{step.title}</h3><p data-i18n={`process.steps.${index}.body`}>{step.body}</p>{index < copy.process.steps.length - 1 && <span class="step-arrow" aria-hidden="true">→</span>}</article>)}</div>
			</section>

			<section class="contact section-wrap" id="contacto">
				<div class="contact-main"><div class="section-label"><span class="section-index">08</span><span data-i18n="contact.label">{copy.contact.label}</span></div><h2 data-i18n="contact.title">{copy.contact.title}</h2><p data-i18n="contact.body">{copy.contact.body}</p><a class="button button-primary" href={linkedin} target="_blank" rel="noreferrer"><span data-i18n="contact.cta">{copy.contact.cta}</span><span class="arrow-up-right" aria-hidden="true"></span></a></div>
				<div class="contact-art"><div class="contact-grid" aria-hidden="true"></div><img src={`${imageRoot}/skoll.png`} alt={copy.contact.mascotAlt} data-i18n-alt="contact.mascotAlt" width="369" height="759" loading="lazy" /><span class="contact-code" aria-hidden="true">KL / 08 — LET’S BUILD</span></div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="footer-top wrap"><a class="brand footer-brand" href="#inicio" aria-label="Kaizen Labs — inicio"><img src={`${imageRoot}/logo.png`} alt="" width="181" height="95" /><span class="brand-name">Kaizen<span>Labs</span></span></a><p data-i18n="footer.descriptor">{copy.footer.descriptor}</p><a class="back-top" href="#inicio"><span data-i18n="footer.back">{copy.footer.back}</span><span aria-hidden="true">↑</span></a></div>
			<div class="footer-bottom wrap"><span>© {new Date().getFullYear()} Kaizen Labs. <span data-i18n="footer.copyright">{copy.footer.copyright}</span></span><div class="footer-links"><span class="footer-heading" data-i18n="footer.links">{copy.footer.links}</span><a href="#capacidades" data-i18n="nav.work">{copy.nav.work}</a><a href="#trayectoria" data-i18n="nav.journey">{copy.nav.journey}</a><a href="#fundador" data-i18n="nav.founder">{copy.nav.founder}</a></div><div class="footer-links footer-social"><span class="footer-heading" data-i18n="footer.socials">{copy.footer.socials}</span><a href={linkedin} target="_blank" rel="noreferrer">LinkedIn <span class="arrow-up-right" aria-hidden="true"></span></a><span class="social-pending">Instagram <small data-i18n="footer.soon">{copy.footer.soon}</small></span><span class="social-pending">Facebook <small data-i18n="footer.soon">{copy.footer.soon}</small></span></div></div>
		</footer>

		<script define:vars={{ content, basePath }}>
			const supported = ["es", "en"];
			const storedLanguage = localStorage.getItem("kaizen-language");
			const browserLanguage = (navigator.languages?.[0] || navigator.language || "").toLowerCase().split("-")[0];
			const routeLanguage = location.pathname.startsWith(`${basePath}en/`) ? "en" : "es";
			let currentLanguage = supported.includes(storedLanguage) ? storedLanguage : supported.includes(browserLanguage) ? browserLanguage : routeLanguage;
			if (currentLanguage !== routeLanguage) location.replace(`${basePath}${currentLanguage === "en" ? "en/" : ""}${location.hash}`);
			const readPath = (object, path) => path.split(".").reduce((value, part) => value?.[part], object);
			const translate = () => {
				const dictionary = content[currentLanguage];
				document.documentElement.lang = currentLanguage;
				document.title = dictionary.meta.title;
				document.querySelectorAll("[data-i18n]").forEach((element) => {
					const value = readPath(dictionary, element.dataset.i18n);
					if (typeof value === "string") element.textContent = value;
				});
				document.querySelectorAll("[data-i18n-alt]").forEach((element) => { element.alt = readPath(dictionary, element.dataset.i18nAlt); });
				document.querySelectorAll("[data-i18n-aria]").forEach((element) => { element.setAttribute("aria-label", readPath(dictionary, element.dataset.i18nAria)); });
				document.querySelector('meta[name="description"]').content = dictionary.meta.description;
				document.querySelector('meta[property="og:title"]').content = dictionary.meta.ogTitle;
				document.querySelector('meta[property="og:description"]').content = dictionary.meta.ogDescription;
				document.querySelector('meta[name="twitter:title"]').content = dictionary.meta.ogTitle;
				document.querySelector('meta[name="twitter:description"]').content = dictionary.meta.ogDescription;
				document.querySelector('link[hreflang="es"]').href = `${location.origin}${basePath}`;
				document.querySelector('link[hreflang="en"]').href = `${location.origin}${basePath}en/`;
				document.querySelector(".language-current").textContent = currentLanguage.toUpperCase();
			};
			translate();
			document.querySelector(".language-toggle").addEventListener("click", () => {
				currentLanguage = currentLanguage === "es" ? "en" : "es";
				localStorage.setItem("kaizen-language", currentLanguage);
				location.assign(`${basePath}${currentLanguage === "en" ? "en/" : ""}${location.hash}`);
			});
			const menuButton = document.querySelector(".menu-toggle");
			menuButton.addEventListener("click", () => {
				const isOpen = menuButton.getAttribute("aria-expanded") === "true";
				menuButton.setAttribute("aria-expanded", String(!isOpen));
				document.querySelector(".primary-nav").classList.toggle("is-open", !isOpen);
			});
			document.querySelectorAll(".primary-nav a").forEach((link) => link.addEventListener("click", () => {
				menuButton.setAttribute("aria-expanded", "false");
				document.querySelector(".primary-nav").classList.remove("is-open");
			}));
			const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
				if (entry.isIntersecting) { entry.target.classList.add("is-visible"); observer.unobserve(entry.target); }
			}), { threshold: 0.14 });
			document.querySelectorAll("[data-reveal]").forEach((item) => observer.observe(item));
		</script>
	</body>
</html>

<style>
	@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');
	:root{font-family:'Manrope',Inter,Arial,sans-serif;color:#f4f5f7;background:#0b0d10;font-synthesis:none;text-rendering:optimizeLegibility;--bg:#0b0d10;--surface:#161a20;--line:#242b35;--text:#f4f5f7;--muted:#a2abba;--cyan:#00e5ff;--mint:#38d996;--mono:'DM Mono',monospace;--wrap:1160px}
